@startuml
skinparam style strictuml
skinparam ActivityFontSize 12
skinparam ActivityDiamondFontSize 11

|#LightCyan|Customer|
|#AliceBlue|CMS|

|Customer|
start
:Open Payment page;

|CMS|
:Register pending order & generate VietQR;
:Start client auto-polling (every 2s);

|Customer|
:View VietQR payment screen\n(Default: Ready to pay);

if (Cancel order?) then (yes)
  |CMS|
  :Validate unpaid PENDING order;
  :Cancel order & refund redeemed points;
  stop
else (no)
endif

if (Switch to COD?) then (yes)
  |CMS|
  :Update payment method to COD;
  :Set order CONFIRMED;
  :Push order to Barista queue (KDS);
  stop
else (no (Default))
endif

|Customer|
:[Default: Bank Transfer]\nScan VietQR code &\ntransfer via banking app;

|CMS|
:Receive SePay webhook notification;
:Reconcile transfer with orders table:\nExtract order code, amount, balance;

if (Reconciliation status?) then (UNDERPAID)
  :Keep order in PENDING status\n(Wait for remaining transfer);
  stop
elseif (OVERPAID) then (OVERPAID)
  :Log refund note\n(Chuyển thừa);
  :Save payment SUCCESS and order CONFIRMED;
else (MATCHED)
  :Save payment SUCCESS and order CONFIRMED;
endif

:Earn points once;
:Push order to Barista queue (KDS);

|Customer|
:Auto-polling detects SUCCESS\n-> Redirect to e-Bill page;
stop
@enduml
