<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%><%@ taglib prefix="fmt" uri="jakarta.tags.fmt"%><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aura Café | Phiếu nhập hàng</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f7f7f7}.main{margin-left:190px;padding:24px}.box{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px}.aura{background:#a51225;color:#fff}@media(max-width:900px){.main{margin-left:0}}</style></head><body><jsp:include page="/components/admin-sidebar.jsp"><jsp:param name="activeMenu" value="purchases"/></jsp:include>
<main class="main"><div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Phiếu nhập hàng</h1><p class="text-muted">Đặt hàng nhà cung cấp và chỉ cộng kho khi xác nhận Đã nhận.</p></div><a href="${ctx}/admin/restock-requests" class="btn btn-outline-dark">Đề xuất nhập hàng</a></div>
<c:if test="${not empty purchaseMessage}"><div class="alert alert-success"><c:out value="${purchaseMessage}"/></div></c:if><c:if test="${not empty purchaseError}"><div class="alert alert-danger"><c:out value="${purchaseError}"/></div></c:if>
<div class="row g-3"><div class="col-lg-4"><section class="box"><h2 class="h5">Tạo phiếu nhập</h2><form method="post"><input type="hidden" name="action" value="create">
<label class="form-label">Từ đề xuất đã duyệt (không bắt buộc)</label><select class="form-select mb-2" name="restockRequestId"><option value="">Không liên kết</option><c:forEach var="r" items="${approvedRequests}"><option value="${r.id}">RR-<fmt:formatNumber value="${r.id}" pattern="0000"/> - <c:out value="${r.reason}"/></option></c:forEach></select>
<label class="form-label">Nhà cung cấp</label><select class="form-select mb-2" name="supplierId" required><c:forEach var="s" items="${activeSuppliers}"><option value="${s.id}"><c:out value="${s.name}"/></option></c:forEach></select>
<label class="form-label">Nguyên liệu</label><select class="form-select mb-2" name="ingredientId" required><c:forEach var="i" items="${allIngredients}"><option value="${i.id}"><c:out value="${i.name}"/> (${i.unit})</option></c:forEach></select>
<label class="form-label">Số lượng nhập</label><input class="form-control mb-2" name="quantity" type="number" min="0.001" step="0.001" required><label class="form-label">Tổng tiền lô</label><input class="form-control mb-2" name="totalPrice" type="number" min="0" step="1" required><label class="form-label">Ghi chú</label><textarea class="form-control mb-3" name="note" maxlength="500"></textarea><button class="btn aura">Tạo phiếu nháp</button></form></section></div>
<div class="col-lg-8"><section class="box"><h2 class="h5">Danh sách phiếu nhập</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã</th><th>Nhà cung cấp / hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="po" items="${purchaseOrders}"><tr><td>PO-<fmt:formatNumber value="${po.id}" pattern="0000"/><c:if test="${not empty po.restockRequestId}"><div class="small text-muted">RR-${po.restockRequestId}</div></c:if></td><td><b><c:out value="${po.supplierName}"/></b><c:forEach var="it" items="${po.items}"><div class="small"><c:out value="${it.ingredientName}"/>: ${it.quantity} ${it.unit} × <fmt:formatNumber value="${it.unitPrice}" pattern="#,##0"/>đ</div></c:forEach></td><td><fmt:formatNumber value="${po.totalCost}" pattern="#,##0"/>đ</td><td>${po.status}</td><td>
<c:if test="${po.status == 'DRAFT'}"><form method="post" class="d-inline"><input type="hidden" name="id" value="${po.id}"><button class="btn btn-sm btn-primary" name="action" value="order">Đặt hàng</button><button class="btn btn-sm btn-outline-danger" name="action" value="cancel">Hủy</button></form></c:if>
<c:if test="${po.status == 'ORDERED'}"><form method="post" class="d-inline"><input type="hidden" name="id" value="${po.id}"><button class="btn btn-sm btn-success" name="action" value="receive">Xác nhận đã nhận</button><button class="btn btn-sm btn-outline-danger" name="action" value="cancel">Hủy</button></form></c:if>
</td></tr></c:forEach><c:if test="${empty purchaseOrders}"><tr><td colspan="5" class="text-center text-muted">Chưa có phiếu nhập.</td></tr></c:if></tbody></table></div></section></div></div></main></body></html>

