<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aura Café | Phiếu nhập hàng</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Material+Symbols+Outlined" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${ctx}/assets/css/admin-schedule.css" rel="stylesheet">
<style>.purchase-page{max-width:1280px;color:#292524}.panel{background:#fff;border:1px solid #e7e5e4;border-radius:16px;box-shadow:0 1px 2px #1c191708}.head{padding:20px}.db{padding:3px 8px;border-radius:5px;background:#f5f5f4;color:#78716c;font:700 10px monospace}.head h1{font-size:24px;font-weight:800;margin:6px 0 3px}.head p{font-size:12px;color:#78716c}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding-top:14px;border-top:1px solid #f5f5f4}.stat{padding:12px;background:#fafaf9;border:1px solid #e7e5e4;border-radius:12px}.stat span{display:block;color:#78716c;font-size:10px;font-weight:800;text-transform:uppercase}.stat strong{font:900 20px monospace}.primary{border:0;border-radius:12px;background:#a51225;color:white;padding:9px 14px;font-size:12px;font-weight:800}.ghost{border:1px solid #e7e5e4;border-radius:12px;background:#f5f5f4;padding:9px 14px;font-size:12px;font-weight:700}.table-head{padding:16px;background:#fafaf980;border-bottom:1px solid #f5f5f4}.table-head h2{font-size:14px;font-weight:800;margin:0}.table{font-size:12px;margin:0}.table th{padding:15px;background:#fafaf9;color:#78716c;white-space:nowrap}.table td{padding:15px;border-color:#f5f5f4}.pill{padding:3px 8px;border-radius:5px;font-size:10px;font-weight:800}.draft{background:#f5f5f4;color:#57534e}.ordered{background:#dbeafe;color:#1e40af}.received{background:#dcfce7;color:#166534}.action-link{border:0;background:none;font-weight:800;color:#a51225}.modal-content{border:0;border-radius:16px}.form-control,.form-select{border-radius:12px;background:#fafaf9;font-size:13px}.field{font-size:11px;font-weight:700}.column{float:right;color:#a8a29e;font:10px monospace}@media(max-width:800px){.stats{grid-template-columns:repeat(2,1fr)}}</style></head>
<body class="admin-body"><jsp:include page="/components/admin-sidebar.jsp"><jsp:param name="activeMenu" value="purchases"/></jsp:include><main class="admin-main-wrapper purchase-page">
<section class="panel head mb-4"><div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="db">Bảng: purchase_orders, purchase_order_items</span><h1>Phiếu nhập hàng</h1><p>Tạo phiếu đặt hàng nhà cung cấp, theo dõi trạng thái và nhập kho khi nhận hàng.</p></div><div class="d-flex gap-2 align-items-start"><a class="ghost text-decoration-none text-dark" href="${ctx}/admin/suppliers">Nhà cung cấp</a><button class="primary" data-bs-toggle="modal" data-bs-target="#createPo">＋ Tạo phiếu nhập</button></div></div><div class="stats"><div class="stat"><span>Nháp</span><strong>2</strong></div><div class="stat"><span>Đã đặt hàng</span><strong>1</strong></div><div class="stat"><span>Đã nhận hàng</span><strong>7</strong></div><div class="stat"><span>Đã hủy</span><strong>1</strong></div></div></section>
<section class="panel overflow-hidden"><div class="table-head d-flex justify-content-between align-items-center"><h2>Danh sách phiếu nhập</h2><select class="form-select form-select-sm w-auto"><option>Tất cả trạng thái</option><option>Nháp</option><option>Đã đặt hàng</option><option>Đã nhận hàng</option><option>Đã hủy</option></select></div><div class="table-responsive"><table class="table"><thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Người tạo</th><th>Ngày tạo</th><th class="text-center">Số dòng</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
<tr><td class="font-monospace fw-bold">PO-0012</td><td>Bakery Ingredient Supply</td><td>Aura Admin</td><td>22/10/2026 03:02</td><td class="text-center">1</td><td class="text-end font-monospace fw-bold">100.000đ</td><td><span class="pill draft">Nháp</span></td><td class="text-end"><button class="action-link">Xem</button><button class="action-link text-primary">Đặt hàng</button><button class="action-link text-danger">Hủy</button></td></tr>
<tr><td class="font-monospace fw-bold">PO-0011</td><td>Fresh Bean Supplier</td><td>Aura Admin</td><td>20/10/2026 09:30</td><td class="text-center">3</td><td class="text-end font-monospace fw-bold">4.250.000đ</td><td><span class="pill ordered">Đã đặt hàng</span></td><td class="text-end"><button class="action-link">Xem</button><button class="action-link text-success">Nhập kho</button></td></tr>
</tbody></table></div></section></main>
<div class="modal fade" id="createPo" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-6 fw-bold">Tạo phiếu nhập hàng</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-4"><form onsubmit="event.preventDefault()"><div class="row g-3"><div class="col-md-6"><label class="field">Nhà cung cấp <span class="column">supplier_id</span></label><select class="form-select mt-1"><option>Fresh Bean Supplier</option><option>Bakery Ingredient Supply</option></select></div><div class="col-md-6"><label class="field">Trạng thái ban đầu <span class="column">status</span></label><select class="form-select mt-1"><option>DRAFT - Lưu nháp</option><option>ORDERED - Đặt hàng ngay</option></select></div></div><div class="border rounded-3 mt-3 p-3"><div class="fw-bold small mb-2">Dòng nguyên liệu (purchase_order_items)</div><div class="row g-2"><div class="col-5"><select class="form-select"><option>Coffee beans (gram)</option><option>Fresh milk (ml)</option></select></div><div class="col-3"><input class="form-control" type="number" value="1000" placeholder="Số lượng"></div><div class="col-3"><input class="form-control" type="number" value="100" placeholder="Đơn giá"></div><div class="col-1 text-center pt-2">×</div></div></div><label class="field d-block mt-3">Ghi chú <span class="column">note</span><textarea class="form-control mt-1" rows="2"></textarea></label><p class="text-end mt-3">Tổng tiền: <strong class="text-danger font-monospace">100.000đ</strong></p><div class="d-flex gap-2 justify-content-end"><button class="ghost" data-bs-dismiss="modal">Hủy</button><button class="primary" data-bs-dismiss="modal">Tạo phiếu nhập</button></div></form></div></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script></body></html>
