.feedback-table{overflow:hidden}.feedback-table table{font-size:12px;margin:0}.feedback-table th{padding:16px;background:#fafaf9;color:#78716c;font-weight:700;border-bottom:1px solid #f5f5f4;white-space:nowrap}.feedback-table td{padding:16px;border-color:#f5f5f4;vertical-align:top}.feedback-table tbody tr:hover{background:#fafaf980}.code{font-family:ui-monospace,monospace;font-weight:700}.order-code{color:#a51225}.customer-phone,.created{font-size:10px;color:#a8a29e}.stars{color:#f59e0b;font-size:14px;white-space:nowrap}.pill{display:inline-block;padding:3px 8px;border-radius:5px;font-size:10px;font-weight:700;white-space:nowrap}.pill-blue{background:#dbeafe;color:#1e40af}.pill-amber{background:#fef3c7;color:#92400e}.pill-pending{background:#fff1f2;color:#be123c}.pill-resolved{background:#dcfce7;color:#166534}
.reply-btn{border:0;border-radius:8px;padding:6px 10px;background:#fff1f2;color:#a51225;font-size:11px;font-weight:800;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}.reply-btn:hover{background:#a51225;color:#fff}.reply-btn .material-symbols-outlined{font-size:14px}.modal-content{border:0;border-radius:16px;overflow:hidden}.modal-header{background:#fafaf9;border-color:#f5f5f4}.modal-title{font-size:14px;font-weight:800}.review-quote{padding:12px;background:#fafaf9;border:1px solid #e7e5e4;border-radius:12px;font-size:12px}.review-quote small{display:block;color:#78716c;font-size:10px;font-weight:800;text-transform:uppercase}.review-quote p{margin:3px 0 0;font-style:italic}.form-label{font-size:12px;font-weight:700;color:#57534e}.db-column{float:right;font:400 10px ui-monospace,monospace;color:#a8a29e}.form-control,.form-select{border-radius:12px;background:#fafaf9;border-color:#e7e5e4;font-size:13px}.btn-aura{background:#a51225;color:#fff;font-size:12px;font-weight:700;border-radius:12px}.btn-soft{background:#f5f5f4;color:#44403c;font-size:12px;font-weight:700;border-radius:12px}@media(max-width:900px){.feedback-stats{grid-template-columns:repeat(2,1fr)}}
</style></head><body class="admin-body">
