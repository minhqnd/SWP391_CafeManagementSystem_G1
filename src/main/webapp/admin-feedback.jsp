<style>
.feedback-page{max-width:1280px;color:#292524}.feedback-head,.feedback-table{background:#fff;border:1px solid #e7e5e4;border-radius:16px;box-shadow:0 1px 2px #1c191708}.feedback-head{padding:20px}.table-ref{padding:3px 8px;border-radius:5px;background:#f5f5f4;color:#78716c;font:700 10px ui-monospace,monospace}.feedback-head h1{font-size:24px;font-weight:800;letter-spacing:-.025em;margin:6px 0 3px}.feedback-head p{font-size:12px;color:#78716c;margin:0}.filter-select{height:36px;padding:0 34px 0 12px;border:1px solid #e7e5e4;border-radius:12px;background:#fafaf9;font-size:12px}
