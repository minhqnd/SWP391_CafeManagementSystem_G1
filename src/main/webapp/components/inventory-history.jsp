<%@ page contentType="text/html; charset=UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<c:if test="${not empty history}"><section class="box mt-4"><h2 class="h5">Lịch sử thao tác gần đây</h2><div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>Mã</th><th>Người thao tác</th><th>Thao tác</th><th>Chi tiết</th></tr></thead><tbody><c:forEach var="h" items="${history}"><tr><td><c:out value="${h.created_at}"/></td><td>${h.entity_id}</td><td><c:out value="${h.full_name}"/></td><td><c:out value="${h.action}"/></td><td style="white-space:pre-wrap"><c:out value="${h.details}"/></td></tr></c:forEach></tbody></table></div></section></c:if>