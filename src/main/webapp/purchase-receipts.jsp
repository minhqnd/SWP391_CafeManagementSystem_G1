<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%><%@ taglib prefix="fmt" uri="jakarta.tags.fmt"%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:if test="${empty requestScope.workflowAdmin}"><c:redirect url="/login"/></c:if>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aura Café | Kho và nhập hàng</title><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="${ctx}/assets/css/admin-schedule.css" rel="stylesheet">
<style>.box{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px}.aura{background:#a51225;color:#fff}.restock-mobile-nav{display:none}@media(max-width:768px){.restock-mobile-nav{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;background:#fff;border-bottom:1px solid #e5e7eb}}</style></head><body class="admin-body"><c:choose><c:when test="${workflowAdmin}"><jsp:include page="/components/admin-sidebar.jsp"><jsp:param name="activeMenu" value="restock"/></jsp:include></c:when><c:otherwise><jsp:include page="/components/header.jsp"><jsp:param name="navbarMode" value="barista"/><jsp:param name="activePage" value="inventory"/></jsp:include></c:otherwise></c:choose><main class="${workflowAdmin ? 'admin-main-wrapper' : 'container py-4'}"><nav class="d-flex flex-wrap gap-3 mb-3" aria-label="Kho và nhập hàng"><a href="${ctx}/${workflowAdmin ? 'admin' : 'barista'}/restock-requests">Đề xuất nguyên liệu</a><a href="${ctx}/${workflowAdmin ? 'admin' : 'barista'}/purchase-receipts">Kiểm nhận hàng</a><c:if test="${workflowAdmin}"><a href="${ctx}/admin/purchases">Đơn mua nhà cung cấp</a></c:if></nav><c:if test="${not empty workflowMessage}"><div class="alert alert-success" role="status"><c:out value="${workflowMessage}"/></div></c:if>
<c:if test="${not empty workflowError}"><div class="alert alert-danger" role="alert"><c:out value="${workflowError}"/></div></c:if><h1 class="h3">Kiểm nhận hàng giao</h1><p>Nhập số lượng giao và phần đạt yêu cầu. Phần còn lại là hàng hỏng/từ chối. Ghi rõ hàng thiếu, thừa và phương án xử lý; quản lý xác nhận mới cộng kho.</p>
<c:forEach var="po" items="${purchaseOrders}"><details class="box mb-3"><summary>Kiểm nhận PO-${po.id} · <c:out value="${po.supplierName}"/></summary><form method="post" class="mt-3"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="action" value="receive"><input type="hidden" name="submissionKey" value="${submissionKey}"><input type="hidden" name="poId" value="${po.id}">
<c:forEach var="it" items="${po.items}"><fieldset class="border rounded p-3 mb-2"><legend class="float-none w-auto fs-6"><c:out value="${it.ingredientName}"/> (${it.unit}) · đặt ${it.quantity}, còn thiếu ${it.remainingQuantity}</legend><input type="hidden" name="itemId" value="${it.id}"><label class="form-label">Số lượng giao lần này</label><input class="form-control mb-2" name="delivered_${it.id}" type="number" min="0" step="0.001" value="0" required><label class="form-label">Số lượng nhận đạt yêu cầu</label><input class="form-control" name="accepted_${it.id}" type="number" min="0" step="0.001" value="0" required></fieldset></c:forEach><label class="form-label">Biên bản kiểm nhận / lý do chênh lệch</label><textarea class="form-control mb-2" name="note" maxlength="500" required></textarea><button class="btn aura">Gửi phiếu kiểm nhận</button></form></details></c:forEach>
<h2 class="h4">Phiếu kiểm nhận</h2><c:forEach var="r" items="${receipts}"><article class="box mb-3"><h3 class="h5">Phiếu #${r.id} · PO-${r.poId} · <c:out value="${r.status}"/></h3><p>Người kiểm: <c:out value="${r.receiverName}"/> · ${r.createdAt}</p><p><c:out value="${r.note}"/></p><p>Ý kiến quản lý: <c:out value="${r.reviewNote}"/> · <c:out value="${r.reviewerName}"/></p>
<table class="table"><thead><tr><th>Nguyên liệu</th><th>Giao</th><th>Nhận đạt</th><th>Từ chối</th><th>Điều chỉnh sau nhận</th></tr></thead><tbody><c:forEach var="it" items="${r.items}"><tr><td><c:out value="${it.ingredientName}"/> (${it.unit})</td><td>${it.delivered}</td><td>${it.accepted}</td><td>${it.rejected}</td><td>${it.adjustment}</td></tr></c:forEach></tbody></table>
<c:if test="${workflowAdmin and r.status == 'PENDING'}"><form method="post"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="id" value="${r.id}"><label class="form-label">Ý kiến xác nhận (ghi rõ chấp nhận hàng thừa nếu có) / lý do từ chối</label><textarea class="form-control mb-2" name="reviewNote" maxlength="500" required></textarea><label class="d-block mb-2"><input type="checkbox" name="acceptExcess" value="yes"> Tôi chấp nhận nhập phần vượt số lượng đặt (nếu có), theo biên bản trên.</label><button class="btn btn-success" name="action" value="approve">Xác nhận và cộng kho</button> <button class="btn btn-outline-danger" name="action" value="reject">Từ chối phiếu</button></form></c:if>
<c:if test="${workflowAdmin and r.status == 'APPROVED'}"><details><summary>Điều chỉnh / trả hàng sau nhận</summary><p>Giá trị âm để giảm/trả hàng, dương để bổ sung số lượng đã ghi thiếu. Phiếu gốc được giữ nguyên.</p><form method="post"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="action" value="adjust"><input type="hidden" name="submissionKey" value="${submissionKey}"><label class="form-label">Nguyên liệu</label><select class="form-select mb-2" name="receiptItemId"><c:forEach var="it" items="${r.items}"><option value="${it.id}"><c:out value="${it.ingredientName}"/></option></c:forEach></select><label class="form-label">Số lượng thay đổi (+ / −)</label><input class="form-control mb-2" type="number" step="0.001" name="delta" required><label class="form-label">Lý do điều chỉnh / trả hàng</label><textarea class="form-control mb-2" name="reason" maxlength="500" required></textarea><button class="btn btn-warning">Ghi điều chỉnh</button></form></details></c:if></article></c:forEach><c:if test="${empty receipts}"><p>Chưa có phiếu kiểm nhận.</p></c:if><jsp:include page="/components/inventory-history.jsp"/></main></body></html>