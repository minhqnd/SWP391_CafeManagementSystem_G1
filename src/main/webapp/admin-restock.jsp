<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%><%@ taglib prefix="fmt" uri="jakarta.tags.fmt"%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:if test="${empty requestScope.workflowAdmin}"><c:redirect url="/login"/></c:if>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aura Café | Kho và nhập hàng</title><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="${ctx}/assets/css/admin-schedule.css" rel="stylesheet">
<style>.box{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px}.aura{background:#a51225;color:#fff}.restock-mobile-nav{display:none}@media(max-width:768px){.restock-mobile-nav{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;background:#fff;border-bottom:1px solid #e5e7eb}}</style></head><body class="admin-body"><c:choose><c:when test="${workflowAdmin}"><jsp:include page="/components/admin-sidebar.jsp"><jsp:param name="activeMenu" value="restock"/></jsp:include></c:when><c:otherwise><jsp:include page="/components/header.jsp"><jsp:param name="navbarMode" value="barista"/><jsp:param name="activePage" value="inventory"/></jsp:include></c:otherwise></c:choose><main class="${workflowAdmin ? 'admin-main-wrapper' : 'container py-4'}"><nav class="d-flex flex-wrap gap-3 mb-3" aria-label="Kho và nhập hàng"><a href="${ctx}/${workflowAdmin ? 'admin' : 'barista'}/restock-requests">Đề xuất nguyên liệu</a><a href="${ctx}/${workflowAdmin ? 'admin' : 'barista'}/purchase-receipts">Kiểm nhận hàng</a><c:if test="${workflowAdmin}"><a href="${ctx}/admin/purchases">Đơn mua nhà cung cấp</a></c:if></nav><c:if test="${not empty workflowMessage}"><div class="alert alert-success" role="status"><c:out value="${workflowMessage}"/></div></c:if>
<c:if test="${not empty workflowError}"><div class="alert alert-danger" role="alert"><c:out value="${workflowError}"/></div></c:if><h1 class="h3">Đề xuất nguyên liệu</h1><p>Barista gửi nhu cầu; quản lý sửa, duyệt hoặc trả lại. Đề xuất chưa làm tăng tồn kho.</p>
<details class="box mb-3"><summary>Tạo đề xuất mới</summary><form method="post" class="mt-3"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><label class="form-label">Nguyên liệu</label><select class="form-select mb-2" name="ingredientId" required><c:forEach var="i" items="${allIngredients}"><option value="${i.id}"><c:out value="${i.name}"/> (${i.unit})</option></c:forEach></select>
<label class="form-label">Số lượng cần</label><input class="form-control mb-2" name="quantity" type="number" min="0.001" step="0.001" required>
<label class="form-label">Lý do</label><input class="form-control mb-2" name="reason" maxlength="500" required>
<label class="form-label">Ghi chú</label><textarea class="form-control mb-2" name="note" maxlength="500"></textarea>
<button class="btn btn-secondary" name="action" value="saveDraft">Lưu nháp</button> <button class="btn aura" name="action" value="create">Gửi duyệt</button></form></details>
<section class="box mb-3"><h2 class="h5">Nguyên liệu sắp hết</h2><c:forEach var="i" items="${lowStockList}"><span class="badge text-bg-light me-2"><c:out value="${i.name}"/>: ${i.currentStock} / ${i.minStockLevel} ${i.unit}</span></c:forEach><c:if test="${empty lowStockList}"><p>Không có nguyên liệu dưới ngưỡng.</p></c:if></section>
<c:forEach var="r" items="${requests}"><article class="box mb-3"><h2 class="h5">RR-${r.id} · <c:out value="${r.status}"/></h2>
<p><c:out value="${r.requesterName}"/> · <c:out value="${r.itemsSummary}"/></p><p><c:out value="${r.reason}"/> — <c:out value="${r.note}"/></p>
<c:if test="${not empty r.reviewNote}"><p class="alert alert-info">Ý kiến quản lý: <c:out value="${r.reviewNote}"/></p></c:if>
<c:if test="${(workflowAdmin and (r.status == 'DRAFT' or r.status == 'PENDING_APPROVAL' or r.status == 'CHANGES_REQUESTED')) or (r.requesterId == sessionScope.user.id and (r.status == 'DRAFT' or r.status == 'CHANGES_REQUESTED'))}">
<details><summary>Sửa nội dung</summary><form method="post" class="mt-2"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="id" value="${r.id}"><input type="hidden" name="action" value="edit">
<c:forEach var="it" items="${r.items}"><label class="form-label">Nguyên liệu</label><select class="form-select mb-2" name="ingredientId" required><option value="${it.ingredientId}"><c:out value="${it.ingredientName}"/></option><c:forEach var="i" items="${allIngredients}"><c:if test="${i.id != it.ingredientId}"><option value="${i.id}"><c:out value="${i.name}"/></option></c:if></c:forEach></select><label class="form-label">Số lượng cần</label><input class="form-control mb-2" name="quantity" type="number" step="0.001" min="0.001" value="${it.quantity}" required></c:forEach>
<label class="form-label">Lý do đề xuất</label><input class="form-control mb-2" name="reason" value="<c:out value='${r.reason}'/>" maxlength="500" required><label class="form-label">Ghi chú</label><textarea class="form-control mb-2" name="note" maxlength="500"><c:out value="${r.note}"/></textarea><label class="form-label">Lý do sửa</label><input class="form-control mb-2" name="editReason" maxlength="500" required><button class="btn btn-primary">Lưu thay đổi</button></form></details>
<form method="post" class="mt-2"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="id" value="${r.id}"><c:if test="${r.status == 'DRAFT' or r.status == 'CHANGES_REQUESTED'}"><button class="btn btn-primary" name="action" value="submit">Gửi duyệt</button> </c:if><button class="btn btn-outline-danger" name="action" value="cancel">Hủy đề xuất</button></form></c:if>
<c:if test="${workflowAdmin and r.status == 'PENDING_APPROVAL' and r.requesterId != sessionScope.user.id}"><form method="post" class="mt-3"><input type="hidden" name="csrfToken" value="${sessionScope.inventoryWorkflowToken}"><input type="hidden" name="id" value="${r.id}"><label class="form-label">Ý kiến duyệt / lý do yêu cầu sửa hoặc từ chối</label><input class="form-control mb-2" name="reviewNote" maxlength="500" required><button class="btn btn-success" name="action" value="approve">Duyệt</button> <button class="btn btn-warning" name="action" value="requestChanges">Yêu cầu sửa</button> <button class="btn btn-outline-danger" name="action" value="reject">Từ chối</button></form></c:if>
</article></c:forEach><c:if test="${empty requests}"><p>Chưa có đề xuất.</p></c:if><jsp:include page="/components/inventory-history.jsp"/></main></body></html>