{
  "name": "payment-gateway",
  "version": "1.0.0",
  "description": "Universal Payment Gateway & Webhook Hub for SePay / VietQR",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute payment-gateway-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute payment-gateway-db --remote --file=./schema.sql",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.162.0"
  }
}
